rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // User avatars — readable by any authenticated user, writable only by the matching user
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size <= 5 * 1024 * 1024;
    }

    // Plan cover images — readable and writable by any authenticated user
    match /covers/{planId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size <= 5 * 1024 * 1024;
    }

    // Post-event photos — readable and writable by any authenticated user
    // Participant check is handled by Firestore, not storage rules
    match /moments/{planId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size <= 10 * 1024 * 1024;
    }

    // Chat media — readable and writable by any authenticated user
    match /chat-media/{roomId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size <= 10 * 1024 * 1024;
    }
  }
}
