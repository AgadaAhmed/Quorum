rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() { return request.auth != null; }

    // True iff the caller is a participant of the given plan (checked against Firestore).
    function planParticipant(planId) {
      return isAuth()
        && firestore.exists(/databases/(default)/documents/plans/$(planId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/plans/$(planId)).data.participants;
    }

    // True iff the caller may post media to a DM room. Mirrors the /chats DM
    // branch in firestore.rules: the room doc (chats/{roomId}) carries the two
    // participant uids, created on chat open.
    function dmMember(roomId) {
      return isAuth()
        && roomId.matches('dm__.*')
        && firestore.exists(/databases/(default)/documents/chats/$(roomId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(roomId)).data.participants;
    }

    // User avatars — any authed user can read; only the owner can write (<=5MB).
    match /avatars/{uid} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == uid
                   && request.resource.size <= 5 * 1024 * 1024;
    }

    // Plan covers are RETIRED — covers are now generated client-side (PlanBanner),
    // never uploaded. Keep read for any legacy objects; deny all new writes.
    match /plan-covers/{planId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Post-event photos on the plan doc (path: plan-photos/{planId}/{photoId}).
    match /plan-photos/{planId}/{photoId} {
      allow read: if isAuth();
      allow write: if planParticipant(planId)
                   && request.resource.size <= 10 * 1024 * 1024;
    }

    // Moments gallery (path: moments/{planId}/...).
    match /moments/{planId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if planParticipant(planId)
                   && request.resource.size <= 10 * 1024 * 1024;
    }

    // Chat media (path: chat-media/{roomId}/{file}). Three room kinds, matching
    // the /chats branches in firestore.rules:
    //   • plan chat   → roomId == planId, caller must be a plan participant
    //   • global chat → roomId == 'global', any authed user
    //   • DM          → roomId == dm__<a>__<b>, caller must be a room participant
    match /chat-media/{roomId}/{file} {
      allow read: if isAuth();
      allow write: if isAuth()
                   && request.resource.size <= 10 * 1024 * 1024
                   && (roomId == 'global' || planParticipant(roomId) || dmMember(roomId));
    }
  }
}
