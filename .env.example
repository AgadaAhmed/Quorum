# Firebase web client config (safe to be public, but kept out of git for hygiene).
# Copy to .env and fill with your Firebase project's values.
# Restrict the API key in Google Cloud Console to your app's bundle ID.
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Klipy GIF API key (Tenor was shut down June 2026). Powers the Pro animated-avatar / banner GIF picker.
# Get a free test key from the Klipy Partner Panel (klipy.com). Passed as a URL path segment; client-side use is fine.
# All requests send rating=g (SFW). Without a key the picker loads but shows an empty state (no crash).
EXPO_PUBLIC_KLIPY_KEY=your-klipy-api-key
