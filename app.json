{
  "expo": {
    "name": "Quorum",
    "slug": "Quorum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quorum",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080608",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "quorums.co.za"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080608",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "backgroundColor": "#080608",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "package": "quorums.co.za"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080608",
          "dark": {
            "backgroundColor": "#080608"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#080608",
          "sounds": []
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Quorum needs calendar access to add confirmed plans to your calendar."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Quorum needs access to your photos to set a profile picture."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-web-browser"
    ],
    "updates": {
      "enabled": false
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22e15dc7-2a61-4aff-ae36-0f930e86fb3d"
      }
    }
  }
}
