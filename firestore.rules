rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // ── Users ────────────────────────────────────────────────────────────────
    // Entitlement fields are written ONLY by the RevenueCat webhook Cloud Function
    // (Admin SDK, which bypasses these rules). Locking them client-side closes the
    // "set my own subscriptionTier = pro" billing hole.
    function lockedEntitlementFields() {
      return ['subscriptionTier', 'subscriptionExpiresAt', 'subscriptionUpdatedAt'];
    }

    match /users/{uid} {
      // Any signed-in user can read profiles (needed for friend lookups, chat, user-profile screen)
      allow read: if isAuth();

      // Owner creates their own doc, but cannot self-assign a paid tier on create.
      allow create: if isAuth() && request.auth.uid == uid
        && (!('subscriptionTier' in request.resource.data)
            || request.resource.data.subscriptionTier == 'free')
        && (!('subscriptionExpiresAt' in request.resource.data)
            || request.resource.data.subscriptionExpiresAt == null);

      allow update: if isAuth() && (
        // Owner may edit their own profile, but NOT the entitlement fields.
        (
          request.auth.uid == uid &&
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(lockedEntitlementFields())
        ) ||
        // Anyone else may only touch social fields (friend-request flow), and
        // still never the entitlement fields.
        (
          request.auth.uid != uid &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['friendRequests', 'friends', 'blockedUsers'])
        )
      );

      allow delete: if isAuth() && request.auth.uid == uid;
    }

    // ── Plans ────────────────────────────────────────────────────────────────
    match /plans/{planId} {
      function uid() { return request.auth.uid; }
      function existing() { return resource.data; }
      function incoming() { return request.resource.data; }
      function changedKeys() { return incoming().diff(existing()).affectedKeys(); }

      function isCreator() { return existing().createdBy == uid(); }
      function isParticipant() { return uid() in existing().participants; }
      // Who may touch the plan at all: public, or a participant, or the creator.
      function canAccess() {
        return existing().isPublic == true || isParticipant() || isCreator();
      }

      // The caller toggles ONLY their own uid in the votes array (no ballot stuffing).
      function votesSelfToggle() {
        return (
          // add self
          (uid() in incoming().votes
            && !(uid() in existing().votes)
            && incoming().votes.size() == existing().votes.size() + 1
            && incoming().votes.hasAll(existing().votes))
          ||
          // remove self
          (!(uid() in incoming().votes)
            && uid() in existing().votes
            && existing().votes.size() == incoming().votes.size() + 1
            && existing().votes.hasAll(incoming().votes))
        );
      }

      // Public plans are visible to all signed-in users; private only to participants/creator.
      allow read: if isAuth() && (
        existing().isPublic == true ||
        uid() in existing().participants ||
        existing().createdBy == uid()
      );

      // Creator creates the plan, sets themselves as creator AND seeds participants with self.
      allow create: if isAuth()
        && incoming().createdBy == uid()
        && uid() in incoming().participants;

      allow update: if isAuth() && (
        // 1. Creator may change anything on their own plan.
        isCreator() ||

        // 2. Vote: toggle only your own vote (public plans or plans you're in).
        (changedKeys().hasOnly(['votes']) && canAccess() && votesSelfToggle()) ||

        // 3. Confirm the plan once quorum is actually reached.
        (changedKeys().hasOnly(['status']) && canAccess()
          && incoming().status == 'confirmed'
          && existing().votes.size() >= existing().requiredVotes) ||

        // 4. Self-join a PUBLIC plan. Private joins go through the invite-code
        //    Cloud Function (a non-participant can't even read a private plan).
        //    Adds only yourself; cannot remove or add anyone else.
        (changedKeys().hasOnly(['participants'])
          && existing().isPublic == true
          && !(uid() in existing().participants)
          && uid() in incoming().participants
          && incoming().participants.size() == existing().participants.size() + 1
          && incoming().participants.hasAll(existing().participants)) ||

        // 5. Leave a plan: remove only yourself from participants (and drop your vote).
        (changedKeys().hasOnly(['participants', 'votes'])
          && isParticipant()
          && !(uid() in incoming().participants)
          && incoming().participants.size() == existing().participants.size() - 1
          && existing().participants.hasAll(incoming().participants)
          && !(uid() in incoming().votes)
          && existing().votes.hasAll(incoming().votes)) ||

        // 6. Collaborative content — participants only, and never protected fields
        //    (title, isPublic, requiredVotes, inviteCode, createdBy, participants…).
        (isParticipant() && changedKeys().hasOnly([
          'reactions', 'poll', 'archivedBy', 'photos',
          'hostRatings', 'checklist', 'comments'
        ]))
      );

      allow delete: if isAuth() && isCreator();

      // Post-event photos live in a subcollection; only plan participants read/write.
      match /moments/{momentId} {
        function planParticipant() {
          return isAuth()
            && exists(/databases/$(database)/documents/plans/$(planId))
            && uid() in get(/databases/$(database)/documents/plans/$(planId)).data.participants;
        }
        allow read, write: if planParticipant();
      }
    }

    // ── Chats ────────────────────────────────────────────────────────────────
    // Room ID == Plan ID. Only plan participants can access.
    match /chats/{roomId} {
      function isPlanParticipant() {
        return isAuth() &&
          exists(/databases/$(database)/documents/plans/$(roomId)) &&
          request.auth.uid in get(/databases/$(database)/documents/plans/$(roomId)).data.participants;
      }

      allow read, write: if isPlanParticipant();

      match /messages/{messageId} {
        allow read, write: if isPlanParticipant();
      }
    }
  }
}
