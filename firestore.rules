rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Any signed-in user can read profiles (needed for friend lookups, chat, user-profile screen)
      allow read: if isAuth();

      // Only owner can create their own doc
      allow create: if isAuth() && request.auth.uid == uid;

      // Owner can update everything; others can only touch social fields
      // (friend requests, friends list, blocked) — needed for friend-request flow
      allow update: if isAuth() && (
        request.auth.uid == uid ||
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['friendRequests', 'friends', 'blockedUsers'])
      );

      allow delete: if isAuth() && request.auth.uid == uid;
    }

    // ── Plans ────────────────────────────────────────────────────────────────
    match /plans/{planId} {
      // Public plans are visible to all signed-in users; private plans only to participants/creator
      allow read: if isAuth() && (
        resource.data.isPublic == true ||
        request.auth.uid in resource.data.participants ||
        resource.data.createdBy == request.auth.uid
      );

      // Any signed-in user can create a plan (must set themselves as creator)
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;

      // Creator can update anything; participants can only add themselves (join)
      allow update: if isAuth() && (
        resource.data.createdBy == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) &&
          request.auth.uid in request.resource.data.participants
        )
      );

      allow delete: if isAuth() && resource.data.createdBy == request.auth.uid;
    }

    // ── Chats ────────────────────────────────────────────────────────────────
    // Room ID == Plan ID. Only plan participants can access.
    match /chats/{roomId} {
      function isPlanParticipant() {
        return isAuth() &&
          exists(/databases/$(database)/documents/plans/$(roomId)) &&
          request.auth.uid in get(/databases/$(database)/documents/plans/$(roomId)).data.participants;
      }

      allow read, write: if isPlanParticipant();

      match /messages/{messageId} {
        allow read, write: if isPlanParticipant();
      }
    }
  }
}
