rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request from a signed-in user?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is the requesting user the document owner?
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Users collection
    match /users/{userId} {
      // Anyone signed in can read user profiles (needed for search, friend names, etc.)
      allow read: if isAuth();

      // Only the user themselves can create their own document
      allow create: if isOwner(userId);

      // Only the user themselves can update most fields
      // Other users can write friendRequests (to send requests) and friends (when accepting)
      allow update: if isAuth() && (
        isOwner(userId) ||
        // Allow other users to update only friendRequests and friends arrays
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['friendRequests', 'friends'])
      );

      allow delete: if isOwner(userId);
    }

    // Plans collection
    match /plans/{planId} {
      // Only participants can read a private plan; anyone signed in can read public plans
      allow read: if isAuth() && (
        resource.data.isPublic == true ||
        request.auth.uid in resource.data.participants
      );

      // Any signed-in user can create a plan
      allow create: if isAuth() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.participants;

      // Participants can update (vote, react, etc.); creator can update all fields
      allow update: if isAuth() && (
        request.auth.uid in resource.data.participants
      );

      // Only the creator can delete
      allow delete: if isAuth() && resource.data.createdBy == request.auth.uid;
    }

    match /plans/{planId}/moments/{momentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/plans/$(planId)).data.participants;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uploadedBy;
    }

    // Chats collection (per-plan rooms)
    match /chats/{roomId}/messages/{messageId} {
      // Anyone signed in can read messages (global room accessible to all)
      allow read: if isAuth();

      // Only the sender can write their own messages
      allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;

      // No editing or deleting messages
      allow update, delete: if false;
    }
  }
}
